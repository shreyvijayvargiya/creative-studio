# Client (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server (Supabase admin, server functions)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (AI assistant + bank statement extraction + creative studio)
OPENROUTER_API_KEY=
# Optional paid/default chat model
OPENROUTER_MODEL=openai/gpt-oss-120b
# Free model used for bank statement → transactions extraction
OPENROUTER_BANK_MODEL=openrouter/free
# Image model for Creative Studio marketplace assets
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Video model for Creative Studio short clips (OpenRouter /api/v1/videos)
OPENROUTER_VIDEO_MODEL=google/veo-3.1
# Chat model for Creative Studio SVG logo generation (code, not image models)
OPENROUTER_LOGO_MODEL=google/gemini-2.5-flash
# Chat model for Creative Studio landing page code generation
OPENROUTER_LANDING_MODEL=google/gemini-2.5-flash

# AWS S3 (bank statements / accounting files via Better Upload)
# Keep Supabase for auth + DB only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Optional aliases:
# AWS_S3_ACCESS_KEY_ID=
# AWS_S3_SECRET_ACCESS_KEY=
# AWS_S3_REGION=
# S3_BUCKET_NAME=

# DocuSeal (e-sign)
DOCUSEAL_API_KEY=

# Google OAuth (user Drive connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google service account (Drive upload)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal subscriptions (client + server)
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Public app URL (redirect URLs)
APP_URL=http://localhost:3000
# Canonical site URL for SEO (sitemap, RSS, llm.txt, Open Graph)
VITE_SITE_URL=http://localhost:3000

# Autosend (transactional email via SMTP)
AUTOSEND_API_KEY=
AUTOSEND_SMTP_KEY=
# Optional: protect POST /api/email/send
# EMAIL_API_SECRET=

# Resend (kept available; new flows use Autosend SMTP)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
