# Client (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server (Supabase admin, server functions)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (AI assistant)
OPENROUTER_API_KEY=

# DocuSeal (e-sign)
DOCUSEAL_API_KEY=

# Google OAuth (user Drive connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google service account (Drive upload)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal subscriptions (client + server)
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Public app URL (redirect URLs)
APP_URL=http://localhost:3000

# Autosend (transactional email via SMTP)
AUTOSEND_API_KEY=
AUTOSEND_SMTP_KEY=
# Optional: protect POST /api/email/send
# EMAIL_API_SECRET=

# Resend (kept available; new flows use Autosend SMTP)
